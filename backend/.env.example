# Base de données PostgreSQL
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/stock_management?schema=public"

# Port d'écoute du backend (API)
PORT=3001

# Adresse d'écoute du backend (M4). Défaut 0.0.0.0 = toutes les interfaces
# (déploiement LAN direct). Derrière un reverse proxy local, lier 127.0.0.1.
HOST=

# ── Anti-CSRF (M1) ─────────────────────────────────────────────────────
# Origines autorisées à émettre des mutations navigateur, séparées par des
# virgules. L'origine du serveur lui-même (SPA servi en production) est
# toujours acceptée. En développement : l'origine Vite.
ORIGINES_AUTORISEES="http://localhost:3000"

# ── Sessions (chantier 2b) — valeurs par défaut raisonnables ──────────
NOM_COOKIE_SESSION="gsit_session"
SESSION_INACTIVITE_MINUTES=30
SESSION_DUREE_GLISSENTE_HEURES=8
SESSION_DUREE_MAX_HEURES=12

# ── Comptes et seed ────────────────────────────────────────────────────
# En production, le seed ne crée qu'un compte Super administrateur dont le
# mot de passe initial vient d'ici (12 caractères minimum) ; il doit être
# changé à la première connexion. Ne jamais committer un mot de passe réel.
ADMIN_INITIAL_PASSWORD=""

# Mot de passe commun des comptes de démonstration (12 caractères minimum).
# Développement uniquement ; refusé en production s'il est absent.
MOT_DE_PASSE_DEMO=

# Mettre à "true" en production pour créer quand même les comptes de
# démonstration (déconseillé). En développement, mettre à "false" pour
# n'obtenir aucun compte.
AUTORISER_SEED_DEMO=""

# Clé AES-256-GCM (32 octets) pour chiffrer PIN/PUK au repos — OBLIGATOIRE en production.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLE_CHIFFREMENT=

# Nombre de sauts de reverse proxy de confiance devant le backend (chantier 3.5,
# grammaire étendue M4 : entier 1..10, mots-clés loopback/linklocal/uniquelocal,
# adresse IP ou CIDR, combinaisons séparées par des virgules — ex. « 1 » ou
# « loopback,10.0.0.0/8 »). Absent/vide = aucun proxy : les en-têtes
# X-Forwarded-* ne sont PAS crus. Une valeur INVALIDE fait échouer le démarrage.
TRUST_PROXY=

# Intervalle (en minutes) entre deux purges planifiées des données techniques
# expirées : sessions, clés d'idempotence, compteurs morts du limiteur de
# connexion (M3). Défaut : 360 (6 heures).
PURGE_INTERVALLE_MINUTES=360
