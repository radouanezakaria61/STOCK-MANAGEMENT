# Base de données PostgreSQL
DATABASE_URL="postgresql://stock_app:stock_app_2026@localhost:5432/stock_management?schema=public"

# Port d'écoute du backend (API)
PORT=3001

# Origine du frontend
FRONTEND_URL="http://localhost:3000"

# Modules métier montés au démarrage.
# Périmètre gelé (achats) : ajouter "achats,appels-offres,ia" pour les réactiver.
MODULES_ACTIFS="dashboard,fournisseurs,utilisateurs,stock,affectations"

# Clé API Gemini — fonctionnalités IA
GEMINI_API_KEY="MY_GEMINI_API_KEY"
