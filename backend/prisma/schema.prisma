// Schéma de données — Gestion de Parc Informatique (IT Asset Management)
// PostgreSQL 16 via Prisma ORM.
//
// Chantier 1 — Fondations de données (02-plan-convergence.md §4.3) :
//  - Clés primaires UUID ; l'identifiant métier lisible migre vers `reference @unique`.
//  - Montants en Decimal(12,2) — la conversion en nombre JSON se fait dans
//    lib/serialisation.ts, jamais en changeant le type en base.
//  - Dates en DateTime — le formatage français se fera à l'affichage.
//  - Historiques protégés par FK onDelete: Restrict + soft delete (`supprimeLe`),
//    plus aucune suppression physique des entités métier.
//  - Traçabilité `creeLe` / `modifieLe` partout ; `seq` supprimée : le tri
//    « plus récent d'abord » est un tri sur creeLe décroissant.
//
// Décision du 22/08/2026 (plan §1.1) : les modules achats sont supprimés.
// Les modèles BonCommande, LigneCommande, Budget, AppelOffres et Offre ont
// été retirés du schéma.
//
// Décision du plan v1.2 §3.2 (chantier 2a) : le modèle Fournisseur est lui
// aussi retiré. La provenance survit sous forme d'un simple champ texte
// `fournisseur` sur ArticleStock (puis Equipement/Licence/Maintenance plus
// tard). Ne recrée pas de table Fournisseur. Le plafond d'engagement et la
// matrice de permissions de Utilisateur disparaissent avec le module achats ;
// le nouveau modèle Societe sert d'étiquette de rattachement (filtres),
// pas de cloisonnement des données.
//
// Chantier 2b (plan v1.2, prompt maître phases 10-14) : RBAC serveur complet
// (Role/Permission/RolePermission), sessions en base derrière un cookie
// HttpOnly (Session + JournalAudit), Utilisateur gagne username/motDePasseHash/
// doitChangerMdp ; la colonne `role` texte est remplacée par la FK roleId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── SOCIÉTÉS ───────────────────────────────

// Étiquette de rattachement (plan v1.2 §3.2) : tout le monde voit tout, les
// listes se filtrent par société. Pas de suppression physique — une société
// fermée est désactivée (actif = false) ou soft-deletée (supprimeLe).
model Societe {
  id              String    @id @default(uuid())
  reference       String    @unique
  nom             String
  codeCourt       String    @unique
  adresse         String?
  ville           String?
  telephone       String?
  email           String?
  identifiantLegal String?  @map("identifiant_legal") // ICE
  actif           Boolean   @default(true)
  notes           String?
  supprimeLe      DateTime?
  creeLe          DateTime  @default(now()) @map("cree_le")
  modifieLe       DateTime  @updatedAt @map("modifie_le")

  utilisateurs Utilisateur[]

  @@map("societes")
}

// ──────────────────────────── UTILISATEURS ────────────────────────────

model Utilisateur {
  id                String   @id @default(uuid())
  reference         String   @unique
  username          String   @unique
  name              String   @map("nom")
  email             String   @unique
  phone             String   @default("") @map("telephone")
  department        String   @map("departement")
  jobTitle          String   @map("fonction")
  status            String
  // Authentification locale (chantier 2b) : hash Argon2id uniquement.
  // Null = compte sans accès local (SSO ultérieur).
  motDePasseHash    String?  @map("mot_de_passe_hash")
  doitChangerMdp    Boolean  @default(false) @map("doit_changer_mdp")
  roleId            String   @map("role_id")
  societeId         String?  @map("societe_id")
  avatarUrl         String   @default("") @map("url_avatar")
  derniereConnexion DateTime?
  supprimeLe        DateTime?
  creeLe            DateTime @default(now()) @map("cree_le")
  modifieLe         DateTime @updatedAt @map("modifie_le")

  // Restrict : impossible de supprimer physiquement une société qui a des comptes.
  societe Societe? @relation(fields: [societeId], references: [id], onDelete: Restrict)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions      Session[]
  auditsJournal JournalAudit[]

  @@index([societeId])
  @@index([roleId])
  @@map("utilisateurs")
}

// ──────────────────────────── RBAC (2b) ───────────────────────────────

// Rôles seedés selon la matrice §5.2 de 01-architecture.md ; les codes sont
// des valeurs d'enum (anglais, convention AGENTS.md).
model Role {
  id     String @id @default(uuid())
  code   String @unique // SUPER_ADMIN | IT_MANAGER | IT_TECHNICIAN | STOCK_MANAGER | AUDITOR | EMPLOYEE
  nom    String
  creeLe DateTime @default(now()) @map("cree_le")

  utilisateurs Utilisateur[]
  permissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // format module.action (stock.ecrire, audit.consulter…)
  description String?
  creeLe      DateTime @default(now()) @map("cree_le")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  accordeLe    DateTime @default(now()) @map("accorde_le")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permissions")
}

// ────────────────────── SESSIONS & AUDIT (2b) ─────────────────────────

// Sessions serveur : le cookie porte un jeton aléatoire (48 octets) ; seule
// son empreinte SHA-256 vit en base. Expiration glissante prolongée par
// l'activité, plafonnée par expireLe.
model Session {
  id               String   @id @default(uuid())
  tokenHash        String   @unique @map("empreinte_jeton")
  utilisateurId    String   @map("utilisateur_id")
  adresseIp        String?  @map("adresse_ip")
  agentUtilisateur String?  @map("agent_utilisateur")
  creeLe           DateTime @default(now()) @map("cree_le")
  expireLe         DateTime @map("expire_le")
  derniereActivite DateTime @default(now()) @map("derniere_activite")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("sessions")
}

// Journal d'audit en écriture seule (AGENTS.md règle 3) : aucune modification,
// aucune suppression. Chantier 3 : valeursAvant/valeursApres (Jsonb) écrites
// depuis chaque transaction métier ; le 2b y trace déjà connexions, refus et
// déconnexions. L'immuabilité est aussi garantie côté PostgreSQL par le
// trigger `journal_audit_immuable` (migration 20260823_chantier3). Jamais de
// mot de passe ni de secret dans ce journal.
model JournalAudit {
  id               String   @id @default(uuid())
  action           String // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, PASSWORD_CHANGED, ASSIGNMENT_CREATED…
  utilisateurId    String?  @map("utilisateur_id") // null si compte inexistant
  identifiantTente String?  @map("identifiant_tente")
  entite           String?
  entiteId         String?  @map("entite_id")
  details          Json?
  valeursAvant     Json?    @map("valeurs_avant")
  valeursApres     Json?    @map("valeurs_apres")
  adresseIp        String?  @map("adresse_ip")
  agentUtilisateur String?  @map("agent_utilisateur")
  creeLe           DateTime @default(now()) @map("cree_le")

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([creeLe])
  @@index([action])
  @@index([utilisateurId])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// ───────────────────── NOTIFICATIONS INTERNES (chantier 3) ────────────
// Aucun email/SMS simulé : canal applicatif interne uniquement. La
// déduplication des alertes persistantes (stock sous seuil) est assurée par
// l'index unique partiel `notifications_alerte_ouverte` : une seule
// notification OUVERTE par (type, entité), quel que soit le nombre de
// rafraîchissements ou la concurrence.
model Notification {
  id          String    @id @default(uuid())
  type        String // STOCK_FAIBLE | MATERIEL_ENDOMMAGE | MAINTENANCE_DEMARREE | MAINTENANCE_TERMINEE | INCOHERENCE_DONNEES | INTERVENTION_ADMIN
  titre       String
  message     String
  statut      String    @default("OUVERTE") // OUVERTE | LUE | RESOLUE
  entite      String?
  entiteId    String?   @map("entite_id")
  cibleOnglet String?   @map("cible_onglet") // onglet frontend à ouvrir au clic
  creeLe      DateTime  @default(now()) @map("cree_le")
  lueLe       DateTime? @map("lue_le")
  resolueLe   DateTime? @map("resolue_le")

  @@index([statut, creeLe])
  @@index([type, entiteId])
  @@map("notifications")
}

// Idempotence serveur (chantier 3) : le client envoie `X-Cle-Idempotence` ;
// la première requête enregistre sa clé et sa réponse, toute retransmission
// (double clic, retry réseau) reçoit la réponse d'origine au lieu de créer un
// doublon. Les clés expirent après 24 h (purge à chaque démarrage).
model RequeteIdempotente {
  cle            String   @id @map("cle")
  empreinteCorps String   @map("empreinte_corps") // SHA-256 du corps POST : même clé + corps différent = conflit 409
  // 0 = réservation en cours (requête en vol) ; la réponse est remplie à la fin.
  statusReponse  Int      @default(0) @map("status_reponse")
  corpsReponse   Json?    @map("corps_reponse")
  creeLe         DateTime @default(now()) @map("cree_le")

  @@map("requetes_idempotentes")
}

// ──────────────────────────── STOCK IT ────────────────────────────────

model ArticleStock {
  id             String    @id @default(uuid())
  reference      String    @unique
  assetTag       String    @map("etiquette")
  name           String    @map("nom")
  category       String    @map("categorie")
  brand          String    @map("marque")
  model          String
  serialNumber   String    @map("numero_serie")
  quantity       Int
  availableQty   Int       @map("quantite_disponible")
  allocatedQty   Int       @map("quantite_affectee")
  // Chantier 3 : les unités parties en maintenance sortent du compteur
  // « affecté » sans redevenir disponibles. Invariant vérifié par contrainte
  // PostgreSQL : quantity = disponible + affectée + maintenance.
  maintenanceQty Int       @default(0) @map("quantite_maintenance")
  minThreshold   Int       @map("seuil_minimum")
  unitPriceMAD   Decimal   @db.Decimal(12, 2) @map("prix_unitaire_mad")
  totalValueMAD  Decimal   @db.Decimal(12, 2) @map("valeur_totale_mad")
  location       String    @map("emplacement")
  status         String
  // Provenance saisie manuellement (champ texte libre, plan v1.2 §3.2 —
  // plus de table Fournisseur)
  fournisseur    String?
  purchaseDate   DateTime? @map("date_achat")
  warrantyExpiry DateTime? @map("fin_garantie")
  assignedTo     Json?     @map("affecte_a")
  specs          Json?
  notes          String    @default("")
  supprimeLe     DateTime?
  creeLe         DateTime  @default(now()) @map("cree_le")
  modifieLe      DateTime  @updatedAt @map("modifie_le")

  mouvements MouvementStock[]

  @@index([category])
  @@index([status])
  @@map("articles_stock")
}

// Journal immuable : pas de modification ni suppression (AGENTS.md règle 3).
model MouvementStock {
  id          String   @id @default(uuid())
  reference   String   @unique
  stockItemId String?  @map("article_id")
  itemName    String   @map("article_nom")
  type        String
  quantity    Int
  performedBy String   @map("effectue_par")
  recipient   String?  @map("destinataire")
  department  String?  @map("departement")
  date        DateTime
  notes       String   @default("")
  creeLe      DateTime @default(now()) @map("cree_le")

  // L'historique survit aux suppressions parce que l'article est soft-deleted
  // et que la FK interdit toute suppression physique (Restrict).
  stockItem ArticleStock? @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@index([stockItemId])
  @@map("mouvements_stock")
}

// ──────────────────────────── AFFECTATIONS ────────────────────────────

model Affectation {
  id                        String   @id @default(uuid())
  reference                 String   @unique
  templateType              String   @map("type_modele")
  formCode                  String?  @map("code_formulaire")
  beneficiaryName           String   @map("beneficiaire_nom")
  beneficiaryEmail          String   @default("") @map("beneficiaire_email")
  beneficiaryPhone          String   @default("") @map("beneficiaire_telephone")
  beneficiaryCin            String   @default("") @map("beneficiaire_cin")
  beneficiaryJobTitle       String   @map("beneficiaire_fonction")
  beneficiaryDepartment     String   @map("beneficiaire_departement")
  beneficiarySite           String   @map("beneficiaire_site")
  assignedDate              DateTime @map("date_affectation")
  status                    String
  authorizedBy              String   @map("autorise_par")
  dsiTitle                  String   @map("intitule_dsi")
  // Champs spécifiques SIM / Smartphone : absents des fiches « matériel standard »
  resourceType              String?  @map("type_ressource")
  hasSimCard                Boolean? @map("avec_sim")
  simOperator               String?  @map("sim_operateur")
  simPhoneNumber            String?  @map("sim_numero")
  simPuk                    String?  @map("sim_puk")
  simPin                    String?  @map("sim_pin")
  hasSmartphone             Boolean? @map("avec_smartphone")
  deviceBrand               String?  @map("appareil_marque")
  deviceImei                String?  @map("appareil_imei")
  deviceModel               String?  @map("appareil_modele")
  deviceConfiguration       String?  @map("appareil_configuration")
  operationType             String?  @map("type_operation")
  restitutionPreviousDevice String?  @map("restitution_appareil_precedent")
  restitutedDeviceCondition String?  @map("etat_appareil_restitue")
  incidentRemarks           String?  @map("remarques_incident")
  termsAccepted             Boolean  @map("conditions_acceptees")
  notes                     String   @default("")
  creeLe                    DateTime @default(now()) @map("cree_le")
  modifieLe                 DateTime @updatedAt @map("modifie_le")

  items        LigneAffectation[]
  returnRecord RetourAffectation?

  @@index([status])
  @@map("affectations")
}

model LigneAffectation {
  id           Int     @id @default(autoincrement())
  assignmentId String  @map("affectation_id")
  stockItemId  String  @map("article_id") // instantané historique ; FK propre au chantier 6
  assetTag     String  @map("etiquette")
  name         String  @map("nom")
  brand        String  @map("marque")
  model        String
  serialNumber String  @map("numero_serie")
  category     String  @map("categorie")
  condition    String  @map("etat")
  accessories  String[]
  specs        Json?
  creeLe       DateTime @default(now()) @map("cree_le")

  affectation Affectation @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("lignes_affectation")
}

model RetourAffectation {
  id                  String   @id @default(uuid())
  assignmentId        String   @unique @map("affectation_id")
  returnDate          DateTime @map("date_retour")
  cause               String
  customCause         String   @default("") @map("cause_personnalisee")
  equipmentCondition  String   @map("etat_equipement")
  accessoriesReturned String[] @map("accessoires_restitues")
  missingAccessories  String[] @map("accessoires_manquants")
  dataWiped           Boolean  @default(false) @map("donnees_effacees")
  bitlockerUnlocked   Boolean  @default(false) @map("bitlocker_deverrouille")
  technicalDiagnosis  String   @default("") @map("diagnostic_technique")
  actionTaken         String   @map("action_effectuee")
  inspectedBy         String   @map("inspecte_par")
  notes               String   @default("")
  creeLe              DateTime @default(now()) @map("cree_le")

  affectation Affectation @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("retours_affectation")
}
